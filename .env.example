# Copy to .env (git-ignored). Real environment variables override these.
# Which provider to use: anthropic | openai | ollama | openai-compatible
AI_PROVIDER=ollama

# Ollama (host only; /v1 is added automatically)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# Database to reflect with:  mockdata infer env:DATABASE_URL
# (postgres://user:pass@host:5432/db | mysql://user:pass@host:3306/db | sqlite:./app.db)
DATABASE_URL=
