# Copy to .env (git-ignored). Real environment variables override these.
# Which provider to use: anthropic | openai | ollama | openai-compatible
AI_PROVIDER=ollama

# Ollama (host only; /v1 is added automatically)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# Database to reflect with:  mockdata infer env:DATABASE_URL
# (postgres://user:pass@host:5432/db | mysql://user:pass@host:3306/db | sqlite:./app.db)
DATABASE_URL=

# --- Accounts mode (a public site with sign-in). Leave MOCKDATA_PUBLIC_URL unset for normal local use. ---
# The address people type: https://your-domain (or http://localhost:4747 to try it). Setting it turns accounts on.
MOCKDATA_PUBLIC_URL=
# Where accounts and each user's private folder live (default ./mockdata-data). Back this folder up.
MOCKDATA_DATA_DIR=
# Email for sign-up and password reset. Resend works over SMTP: host smtp.resend.com, port 465,
# secure true, user "resend", password = your Resend API key (verify your sending domain in Resend first).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Google sign-in (optional). Redirect URI to register in Google Cloud: <MOCKDATA_PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to 1 when a reverse proxy on this machine sits in front, so rate limits see each visitor's address.
MOCKDATA_TRUST_PROXY=
# Per-user and server limits (defaults shown).
# MOCKDATA_LLM_DAILY_ROWS=2000
# MOCKDATA_MAX_ROWS=200000
# MOCKDATA_USER_QUOTA_MB=50
# MOCKDATA_MAX_RUNS=4
