{
  "name": "mockdata",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "ui": "node packages/server/dist/bin.js",
    "dev": "node scripts/dev.mjs",
    "typecheck": "npm run build",
    "build": "tsc -p packages/core && tsc -p packages/llm && tsc -p packages/inputs && tsc -p packages/cli && tsc -p packages/mcp && tsc -p packages/server && npm run build -w packages/web && node scripts/bundle-web.mjs",
    "pack:packages": "npm run build && node scripts/pack-packages.mjs",
    "test:packages": "npm run build && node scripts/test-packages.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.1.11",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leapbase/mockdata.git"
  },
  "homepage": "https://mockdata.com"
}
